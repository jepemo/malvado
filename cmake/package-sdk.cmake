if(NOT BUILD OR NOT OUTPUT)
  message(FATAL_ERROR "Provide BUILD and OUTPUT directories")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/version.cmake")
get_filename_component(build "${BUILD}" ABSOLUTE)
get_filename_component(output "${OUTPUT}" ABSOLUTE)
set(stage "${output}/malvado-sdk-stage")
if(NOT EXISTS "${build}/malvado-sdk-target.txt")
  message(FATAL_ERROR "SDK target information is missing; configure the build again")
endif()
file(STRINGS "${build}/malvado-sdk-target.txt" sdk_target)
list(LENGTH sdk_target target_count)
if(NOT target_count EQUAL 2)
  message(FATAL_ERROR "SDK target information is invalid")
endif()
list(GET sdk_target 0 sdk_system)
list(GET sdk_target 1 sdk_arch)
if(NOT sdk_system MATCHES "^[A-Za-z0-9_.-]+$" OR NOT sdk_arch MATCHES "^[A-Za-z0-9_.-]+$")
  message(FATAL_ERROR "SDK target name is invalid")
endif()
set(archive_name "malvado-sdk-${MALVADO_VERSION_STRING}-${sdk_system}-${sdk_arch}.tar.gz")
set(archive "${output}/${archive_name}")
if(EXISTS "${stage}" OR EXISTS "${archive}" OR EXISTS "${archive}.sha256")
  message(FATAL_ERROR "SDK output already exists in ${output}")
endif()
file(MAKE_DIRECTORY "${output}" "${stage}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${build}" --prefix "${stage}" --config "${CONFIG}"
  RESULT_VARIABLE result)
if(result EQUAL 0)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${archive}" --format=gnutar .
    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result)
endif()
if(NOT result EQUAL 0)
  file(REMOVE_RECURSE "${stage}")
  message(FATAL_ERROR "SDK package creation failed")
endif()
file(SHA256 "${archive}" hash)
file(WRITE "${archive}.sha256" "${hash}  ${archive_name}\n")
file(REMOVE_RECURSE "${stage}")
message(STATUS "Created ${archive}")
