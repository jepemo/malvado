---
import { Code } from 'astro:components';
import Companion from '../components/Companion.astro';
import '../styles/home.css';
import example from '../../../../examples/move/main.lua?raw';
import { repoLink, repository, version } from '../../scripts/site-context.mjs';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const code = example.split('\n').slice(3).join('\n').trim();
const title = version ? `Malvado ${version}` : 'Malvado';
const description = 'A game engine inspired by DIV Games Studio.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href={base} aria-label="Malvado home"><span class="mark" aria-hidden="true">m<span>·</span></span> malvado</a>
        <nav aria-label="Main navigation"><a href={`${base}docs/`}>Documentation</a><a href={repository}>GitHub <span aria-hidden="true">↗</span></a></nav>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title">{title}</h1>
            <p class="intro">{description} Write games in C or Lua. Rust support is experimental.</p>
            <div class="actions"><a class="button primary" href={`${base}getting-started/`}>Get started <span aria-hidden="true">→</span></a></div>
          </div>
          <div class="hero-art"><Companion /></div>
        </section>
        <section class="showcase" aria-labelledby="code-title">
          <div class="showcase-copy"><h2 id="code-title">Your first process</h2><p>One small process draws a circle and moves it with the arrow keys. Give every character and object in your game its own process, then call <code>frame()</code> to give the next one its turn.</p><a class="text-link" href={`${base}docs/samples/`}>See C, Lua and Rust examples <span aria-hidden="true">→</span></a></div>
          <div class="code-window"><div class="code-title"><span><i></i><i></i><i></i></span><span>move / main.lua</span><span> LUA </span></div><Code code={code} lang="lua" theme="github-light" /></div>
        </section>
      </main>
      <footer class="site-footer"><a class="wordmark" href={base}><span class="mark" aria-hidden="true">m<span>·</span></span> malvado</a><nav aria-label="Footer"><a href={repoLink('LICENSE')}>Apache-2.0 ↗</a></nav></footer>
    </div>
  </body>
</html>
