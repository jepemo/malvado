---
import { Code } from 'astro:components';
import CodeShowcase from '../components/CodeShowcase.astro';
import '../styles/home.css';
import helloWorld from '../../../../examples/helloworld/main.lua?raw';
import processes from '../../../../examples/meteors/main.lua?raw';
import movement from '../../../../examples/move/main.lua?raw';
import { repoLink, repository, version } from '../../scripts/site-context.mjs';
import { stable, prerelease } from '../../scripts/release.mjs';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const title = version ? `Malvado ${version}` : 'Malvado';
const description = 'An open-source engine for 2D games in C and Lua, with experimental Rust support. Inspired by DIV Games Studio, every character and object runs as its own process.';
const stripHeader = (code) => code.replace(/^(?:--[^\n]*\n)+\s*/, '').trim();
const examples = [
  { id: 'hello', label: 'Hello World', file: 'helloworld / main.lua', code: stripHeader(helloWorld) },
  { id: 'processes', label: 'Processes', file: 'meteors / main.lua', code: stripHeader(processes) },
  { id: 'movement', label: 'Movement', file: 'move / main.lua', code: stripHeader(movement) },
];
const installReady = stable.trim() !== '';
const installCommand = installReady
  ? 'curl -fsSL https://malvado.dev/install.sh | bash'
  : `curl -fsSL https://malvado.dev/install.sh | bash -s -- --version ${prerelease}`;
const nav = [
  { label: 'Docs', href: `${base}docs/` },
  { label: 'Examples', href: `${base}docs/examples/` },
  { label: 'API', href: `${base}docs/reference/lua/` },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href={base} aria-label="Malvado home">
          <img src={`${base}brand/brand-mark.svg`} width="56" height="31" alt="" />
          <span>malvado</span>
        </a>
        <nav aria-label="Main navigation">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a class="nav-github" href={repository} aria-label="GitHub">
            <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-art" aria-hidden="true">
          <img src={`${base}brand/hero-landscape-transparent.webp`} width="1116" height="847" alt="" decoding="async" />
        </div>
        <div class="shell">
          <div class="hero-copy">
            <h1 id="hero-title"><span class="line">A game engine</span> <span class="line">for creative developers<span class="dot">.</span></span></h1>
            <p class="lead">{description}</p>
            <CodeShowcase examples={examples} default="hello" />
            <div class="actions">
              <a class="button primary" href={`${base}docs/start/first-program/`}>Get Started <span aria-hidden="true">→</span></a>
              <a class="text-link" href={repository}>View on GitHub <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </section>
      <section class="section" aria-labelledby="install-title">
        <div class="shell">
          <h2 id="install-title">Install Malvado</h2>
          <p class="section-lead">Get started with Malvado in seconds. The installer downloads a prebuilt SDK, verifies its SHA-256 checksum and prepares the <code>malvado</code> command. No compiler or repository checkout is needed.</p>
          <div class="code-window terminal" data-copy-block>
            <div class="code-title">
              <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="code-file">bash</span>
              <button type="button" class="code-copy" data-copy>Copy</button>
            </div>
            <Code code={installCommand} lang="bash" theme="github-dark" />
          </div>
          {installReady ? (
            <p class="section-note">Requires macOS arm64 or Linux x86_64. On Windows, download the SDK from <a href={`${repository}/releases`}>GitHub Releases</a>. See the <a href={`${base}docs/start/installation/`}>installation guide</a> for the full setup.</p>
          ) : (
            <p class="section-note">Malvado 2.0 is in beta and the stable v2.0.0 release is not published yet, so this command installs the verified <strong>{prerelease}</strong> SDK. It requires macOS arm64 or Linux x86_64; on Windows, download the SDK from <a href={`${repository}/releases`}>GitHub Releases</a>. See the <a href={`${base}docs/contributing/build/`}>source build guide</a> for contributor setup.</p>
          )}
        </div>
      </section>
      <section class="section" aria-labelledby="why-title">
        <div class="shell">
          <h2 id="why-title">Why Malvado?</h2>
          <div class="why-grid">
            <div>
              <h3>Process-oriented programming</h3>
              <p>Every character, object or effect runs as its own process. The scheduler interleaves them, so you write one behavior at a time.</p>
            </div>
            <div>
              <h3>Simple, expressive API</h3>
              <p>Draw, move and test collisions with short calls, using a lightweight model inspired by DIV Games Studio.</p>
            </div>
            <div>
              <h3>Multiple languages</h3>
              <p>Write games in C or Lua, with experimental Rust support. All three share the same core scheduler.</p>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="shell">
        <a class="wordmark" href={base}><img src={`${base}brand/brand-mark.svg`} width="42" height="23" alt="" /><span>malvado</span></a>
        <nav aria-label="Footer"><a href={repoLink('LICENSE')}>Apache-2.0 ↗</a></nav>
      </div>
    </footer>
    <script>
      for (const button of document.querySelectorAll('[data-copy]')) {
        button.addEventListener('click', async () => {
          const block = button.closest('[data-copy-block]');
          const code = block ? block.querySelector('pre code')?.textContent ?? '' : '';
          try {
            await navigator.clipboard.writeText(code);
            button.textContent = 'Copied!';
          } catch {
            button.textContent = 'Press Ctrl/⌘ + C';
          }
          setTimeout(() => { button.textContent = 'Copy'; }, 1600);
        });
      }
    </script>
  </body>
</html>
