---
import { Code } from 'astro:components';
import Companion from '../components/Companion.astro';
import '../styles/home.css';
import example from '../../../../examples/c/processes/main.lua?raw';

const base = import.meta.env.BASE_URL;
const code = example.split('\n').slice(3).join('\n').trim();
const github = 'https://github.com/jepemo/malvado';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Malvado is a game engine inspired by DIV Games Studio, with a C core and Lua and C APIs." />
    <meta property="og:title" content="Malvado — Make games. Think in processes." />
    <meta property="og:description" content="A game engine inspired by DIV Games Studio. Powered by C and Lua." />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://jepemo.github.io/malvado/" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>Malvado — Make games. Think in processes.</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href={base} aria-label="Malvado home"><span class="mark" aria-hidden="true">m<span>·</span></span> malvado</a>
        <nav aria-label="Main navigation"><a href={`${base}docs/`}>Documentation</a><a href={github}>GitHub <span aria-hidden="true">↗</span></a></nav>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span aria-hidden="true">✳</span> A little engine with big ideas</p>
            <h1 id="hero-title">Make games.<br /><em>Think in processes.</em></h1>
            <p class="intro">A game engine inspired by DIV Games Studio. Powered by C and Lua.</p>
            <div class="actions"><a class="button primary" href={`${base}docs/getting-started/`}>Get started <span aria-hidden="true">→</span></a><a class="button secondary" href={`${base}docs/`}>Documentation</a></div>
            <p class="status"><span class="status-dot" aria-hidden="true"></span> Malvado 2 is in development. Come build with us.</p>
          </div>
          <div class="hero-art"><Companion /><span class="art-label">PLAYER 01 <span aria-hidden="true">✳</span> READY</span></div>
        </section>
        <div class="divider" aria-hidden="true"><span>01 / THE IDEA</span><span>✳ ✳ ✳</span></div>
        <section class="showcase" aria-labelledby="code-title">
          <div class="showcase-copy"><p class="eyebrow">Small pieces. Big worlds.</p><h2 id="code-title">A game is a<br /><em>little world</em> of processes.</h2><p>Give each character or task its own process. Let it do a little work, then call <code>frame()</code> to yield to the next tick.</p><a class="text-link" href={`${base}docs/samples/`}>See this example in Lua and C <span aria-hidden="true">→</span></a></div>
          <div class="code-window"><div class="code-title"><span><i></i><i></i><i></i></span><span>processes / main.lua</span><span> LUA </span></div><Code code={code} lang="lua" theme="github-light" /></div>
        </section>
        <div class="divider" aria-hidden="true"><span>02 / THE GOOD STUFF</span><span>✳ ✳ ✳</span></div>
        <section class="features" aria-label="About the engine">
          <article><span class="feature-number">01</span><h3>Made of processes</h3><p>Keep a character’s state and behavior together. The shared scheduler takes care of the ticks.</p></article>
          <article><span class="feature-number">02</span><h3>Two ways to play</h3><p>Write games in Lua or C. Both use the same engine core and process model.</p></article>
          <article><span class="feature-number">03</span><h3>Open source, always</h3><p>Read the code, explore examples, and help shape the next version.</p></article>
        </section>
      </main>
      <footer class="site-footer"><div><a class="wordmark" href={base}><span class="mark" aria-hidden="true">m<span>·</span></span> malvado</a><p>Made for the joy of making games.</p></div><nav aria-label="Footer"><a href={`${base}docs/`}>Documentation</a><a href={github}>GitHub ↗</a><a href={`${github}/blob/master/LICENSE`}>Apache-2.0 ↗</a><a href="https://jepemo.github.io/malvado/legacy/">Legacy docs ↗</a></nav><small>Malvado 2 · In development</small></footer>
    </div>
  </body>
</html>
