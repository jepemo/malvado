file(READ "${SOURCE}/src/binding/runtime.c" runtime)
file(READ "${SOURCE}/docs/api/lua-globals.md" documentation)
string(REGEX MATCH "static const char \\*const global_names\\[\\] = \\{[^}]*\\}" exports "${runtime}")
if(NOT exports)
  message(FATAL_ERROR "Cannot find global export table")
endif()
string(REGEX MATCHALL "\"[A-Za-z_0-9]+\"" names "${exports}")
set(seen "")
foreach(quoted IN LISTS names)
  string(REPLACE "\"" "" name "${quoted}")
  list(FIND seen "${name}" duplicate)
  if(NOT duplicate EQUAL -1)
    message(FATAL_ERROR "Duplicate global export: ${name}")
  endif()
  list(APPEND seen "${name}")
  string(FIND "${documentation}" "| `${name}` | `mv.${name}` |" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "Global export is not documented: ${name}")
  endif()
endforeach()
string(REGEX MATCHALL "\\| `[A-Za-z_0-9]+` \\| `mv\\.[A-Za-z_0-9]+` \\|" rows "${documentation}")
list(LENGTH names name_count)
list(LENGTH rows row_count)
if(NOT name_count EQUAL row_count)
  message(FATAL_ERROR "Global documentation has missing, duplicate, or extra rows")
endif()
