if(NOT ARCHIVE OR NOT SOURCE OR NOT WORK)
  message(FATAL_ERROR "Provide ARCHIVE, SOURCE, and WORK")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/sdk" "${WORK}/outside")
if(NOT EXISTS "${ARCHIVE}.sha256")
  message(FATAL_ERROR "SDK checksum is missing")
endif()
file(SHA256 "${ARCHIVE}" actual)
file(READ "${ARCHIVE}.sha256" recorded)
get_filename_component(archive_name "${ARCHIVE}" NAME)
if(NOT recorded STREQUAL "${actual}  ${archive_name}\n")
  message(FATAL_ERROR "SDK checksum does not match")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${ARCHIVE}" WORKING_DIRECTORY "${WORK}/sdk"
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot extract SDK")
endif()
function(check_dependencies binary)
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    execute_process(COMMAND otool -L "${binary}" RESULT_VARIABLE status OUTPUT_VARIABLE dependencies ERROR_VARIABLE error)
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    execute_process(COMMAND ldd "${binary}" RESULT_VARIABLE status OUTPUT_VARIABLE dependencies ERROR_VARIABLE error)
  else()
    message(FATAL_ERROR "Dependency inspection is not supported on this host")
  endif()
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect dependencies of ${binary}: ${error}")
  endif()
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    # otool prints the inspected binary's path on the first line.
    string(REGEX REPLACE "^[^\n]*\n" "" dependencies "${dependencies}")
  endif()
  string(FIND "${dependencies}" "${WORK}/" work_reference)
  string(FIND "${dependencies}" "${SOURCE}/" source_reference)
  if(NOT work_reference EQUAL -1 OR NOT source_reference EQUAL -1 OR dependencies MATCHES "not found")
    message(FATAL_ERROR "Unexpected dependency for ${binary}:\n${dependencies}")
  endif()
  message(STATUS "Dependencies of ${binary}:\n${dependencies}")
endfunction()
foreach(notice LICENSE Lua-readme.html raylib-LICENSE cJSON-LICENSE)
  if(NOT EXISTS "${WORK}/sdk/share/licenses/malvado/${notice}")
    message(FATAL_ERROR "SDK license notice is missing: ${notice}")
  endif()
endforeach()
set(cli "${WORK}/sdk/bin/malvado")
set(info "${WORK}/sdk/share/malvado/malvado-sdk-info.txt")
if(NOT EXISTS "${info}")
  message(FATAL_ERROR "SDK information is missing")
endif()
file(STRINGS "${info}" info_lines)
list(LENGTH info_lines info_count)
if(NOT info_count EQUAL 3)
  message(FATAL_ERROR "SDK information is invalid")
endif()
list(GET info_lines 0 version_line)
list(GET info_lines 1 system_line)
list(GET info_lines 2 arch_line)
if(NOT version_line MATCHES "^version=([A-Za-z0-9_.-]+)$")
  message(FATAL_ERROR "SDK version is invalid")
endif()
set(sdk_version "${CMAKE_MATCH_1}")
if(NOT system_line MATCHES "^system=([A-Za-z0-9_.-]+)$")
  message(FATAL_ERROR "SDK system is invalid")
endif()
set(sdk_system "${CMAKE_MATCH_1}")
if(NOT arch_line MATCHES "^architecture=([A-Za-z0-9_.-]+)$")
  message(FATAL_ERROR "SDK architecture is invalid")
endif()
set(sdk_arch "${CMAKE_MATCH_1}")
if(NOT archive_name STREQUAL "malvado-sdk-${sdk_version}-${sdk_system}-${sdk_arch}.tar.gz")
  message(FATAL_ERROR "SDK information does not match the archive name")
endif()
execute_process(COMMAND "${cli}" --version RESULT_VARIABLE result OUTPUT_VARIABLE cli_version OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR NOT cli_version STREQUAL "malvado ${sdk_version}")
  message(FATAL_ERROR "SDK information does not match the client version: ${cli_version}")
endif()
check_dependencies("${cli}")
check_dependencies("${WORK}/sdk/libexec/malvado/malvado-game")
check_dependencies("${WORK}/sdk/libexec/malvado/malvado-native-game")
foreach(test cli_project native_cli export_game)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCLI=${cli}" "-DWORK=${WORK}/${test}"
    "-DVISUAL=${VISUAL}" -DKEEP_EXPORT=ON -P "${SOURCE}/tests/${test}.cmake" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Installed SDK ${test} check failed")
  endif()
endforeach()
if(VISUAL)
  set(project "${WORK}/C graphical game")
  execute_process(COMMAND "${cli}" new --c "${project}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "C game creation failed")
  endif()
  file(WRITE "${project}/data.txt" "asset")
  file(WRITE "${project}/main.c" [=[
#include <stdio.h>
#include <malvado/platform.h>
int main(void) {
  FILE *file = fopen("data.txt", "rb");
  if (!file) return 1;
  fclose(file);
  if (!mv_window_open(160, 100, "C game")) return 1;
  for (int i = 0; i < 3; ++i) {
    mv_window_begin((MvColor){0, 0, 0, 255});
    mv_window_draw_text("Hello", 10, 10, 20, (MvColor){255, 255, 255, 255});
    mv_window_end();
  }
  mv_window_close();
  return 0;
}
]=])
  execute_process(COMMAND "${cli}" run "${project}" WORKING_DIRECTORY "${WORK}/outside" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "C game run failed")
  endif()
  execute_process(COMMAND "${cli}" export WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "C game export failed")
  endif()
  check_dependencies("${project}/dist/game/game-bin")
  execute_process(COMMAND "${project}/dist/game/game" WORKING_DIRECTORY "${WORK}/outside" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Exported C game failed")
  endif()
endif()
file(REMOVE_RECURSE "${WORK}/sdk")
if(VISUAL)
  set(game_args "")
else()
  set(game_args "--headless")
endif()
execute_process(COMMAND "${WORK}/export_game/exported game/game" ${game_args}
  WORKING_DIRECTORY "${WORK}/outside" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "export works")
  message(FATAL_ERROR "Exported Lua game needs the SDK: ${output}")
endif()
execute_process(COMMAND "${WORK}/native_cli/C game/dist/game/game"
  WORKING_DIRECTORY "${WORK}/outside" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "native game works")
  message(FATAL_ERROR "Exported C game needs the SDK: ${output}")
endif()
if(CMAKE_HOST_APPLE)
  execute_process(COMMAND "${WORK}/export_game/Lua game.app/Contents/MacOS/game" ${game_args}
    WORKING_DIRECTORY "${WORK}/outside" RESULT_VARIABLE result OUTPUT_VARIABLE output)
  if(NOT result EQUAL 0 OR NOT output MATCHES "export works")
    message(FATAL_ERROR "Exported Lua app needs the SDK: ${output}")
  endif()
  execute_process(COMMAND "${WORK}/native_cli/C game/dist/game.app/Contents/MacOS/game"
    WORKING_DIRECTORY "${WORK}/outside" RESULT_VARIABLE result OUTPUT_VARIABLE output)
  if(NOT result EQUAL 0 OR NOT output MATCHES "native game works")
    message(FATAL_ERROR "Exported C app needs the SDK: ${output}")
  endif()
endif()
if(VISUAL)
  execute_process(COMMAND "${project}/dist/game/game" WORKING_DIRECTORY "${WORK}/outside" RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Exported graphical C game needs the SDK")
  endif()
endif()
if(NOT KEEP_OUTPUT)
  file(REMOVE_RECURSE "${WORK}")
endif()
