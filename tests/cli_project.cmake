file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${CLI}" --help RESULT_VARIABLE result OUTPUT_VARIABLE output)
string(FIND "${output}" "new [--lang lua|c|rust] PATH" new_usage)
if(NOT result EQUAL 0 OR new_usage EQUAL -1 OR output MATCHES "new[^\n]*--c" OR NOT output MATCHES "export.*Export")
  message(FATAL_ERROR "Help did not list commands: ${output}")
endif()
execute_process(COMMAND "${CLI}" --version RESULT_VARIABLE result OUTPUT_VARIABLE output)
include("${CMAKE_CURRENT_LIST_DIR}/../tools/cmake/version.cmake")
string(STRIP "${output}" output)
if(NOT result EQUAL 0 OR NOT output STREQUAL "malvado ${MALVADO_VERSION_STRING}")
  message(FATAL_ERROR "Version was not reported: ${output}")
endif()
execute_process(COMMAND "${CLI}" doctor RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "Lua: Lua 5.4" OR NOT output MATCHES "CMake:" OR NOT output MATCHES "Graphics:" OR NOT output MATCHES "Export:")
  message(FATAL_ERROR "Doctor did not report runtime capabilities: ${output}")
endif()
if(CMAKE_HOST_UNIX)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PATH=" "${CLI}" doctor WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output)
  if(NOT result EQUAL 0 OR NOT output MATCHES "CMake: not found")
    message(FATAL_ERROR "Doctor did not detect missing CMake: ${output}")
  endif()
endif()
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  execute_process(COMMAND "${CLI}" export --app WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE result)
  if(NOT result EQUAL 1 OR EXISTS "${WORK}/dist")
    message(FATAL_ERROR "App export must report that macOS is required")
  endif()
endif()
set(invalid_work "${WORK}/invalid arguments")
file(MAKE_DIRECTORY "${invalid_work}")
foreach(arguments "" "--lang" "--lang;c" "--lang;unknown;bad" "--c" "--c;bad"
    "--unknown" "--unknown;bad" "--lang=c;bad" "--lang;lua;--lang;c;bad"
    "--lang;lua;--c" "bad;--lang;c" "bad;extra" "--lang;c;bad;extra")
  execute_process(COMMAND "${CLI}" new ${arguments} WORKING_DIRECTORY "${invalid_work}"
    RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
  file(GLOB artifacts "${invalid_work}/*")
  if(NOT result EQUAL 2 OR diagnostic STREQUAL "" OR artifacts)
    message(FATAL_ERROR "Invalid new arguments '${arguments}' returned ${result} with artifacts '${artifacts}': ${diagnostic}")
  endif()
endforeach()
set(project "${WORK}/My game")
set(native_project "${WORK}/C game")
execute_process(COMMAND "${CLI}" new --lang c "${native_project}" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${native_project}/main.c" OR NOT EXISTS "${native_project}/CMakeLists.txt")
  message(FATAL_ERROR "Could not create C project")
endif()
file(READ "${native_project}/CMakeLists.txt" native_cmake)
if(NOT native_cmake MATCHES "if\\(ANDROID\\)" OR NOT native_cmake MATCHES "malvado_add_android_game\\(game main\\.c\\)")
  message(FATAL_ERROR "Generated C project is missing Android CMake configuration")
endif()
file(READ "${native_project}/main.c" native_starter)
execute_process(COMMAND "${CLI}" new --lang c "${native_project}" RESULT_VARIABLE result)
file(READ "${native_project}/main.c" native_after)
file(READ "${native_project}/CMakeLists.txt" native_cmake_after)
if(NOT result EQUAL 1 OR NOT native_starter STREQUAL native_after OR NOT native_cmake STREQUAL native_cmake_after)
  message(FATAL_ERROR "Existing C project was accepted or changed")
endif()
execute_process(COMMAND "${CLI}" new "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${project}/main.lua")
  message(FATAL_ERROR "Could not create project")
endif()
file(READ "${project}/main.lua" starter)
if(NOT starter MATCHES "return [{]" OR NOT starter MATCHES "init = function")
  message(FATAL_ERROR "Generated game does not use a declarative entry")
endif()
set(explicit_lua "${WORK}/Explicit Lua game")
execute_process(COMMAND "${CLI}" new --lang lua "${explicit_lua}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Explicit Lua project creation failed")
endif()
file(GLOB default_files RELATIVE "${project}" "${project}/*")
file(GLOB explicit_files RELATIVE "${explicit_lua}" "${explicit_lua}/*")
if(NOT default_files STREQUAL explicit_files OR (REQUIRE_LUA_CONFIG AND NOT EXISTS "${project}/.luarc.json"))
  message(FATAL_ERROR "Default and explicit Lua project files differ or installed SDK config is missing")
endif()
foreach(template_file IN LISTS default_files)
  file(SHA256 "${project}/${template_file}" default_hash)
  file(SHA256 "${explicit_lua}/${template_file}" explicit_hash)
  if(NOT default_hash STREQUAL explicit_hash)
    message(FATAL_ERROR "Default and explicit Lua projects have different ${template_file} contents")
  endif()
endforeach()
file(MAKE_DIRECTORY "${project}/scripts" "${project}/.hidden")
file(WRITE "${project}/scripts/helper.lua" "return {}\n")
file(WRITE "${project}/.hidden/ignored.lua" "function broken(\n")
execute_process(COMMAND "${CLI}" check WORKING_DIRECTORY "${project}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "Syntax OK")
  message(FATAL_ERROR "Could not check generated game: ${output}")
endif()
if(NOT output MATCHES "helper.lua")
  message(FATAL_ERROR "Nested Lua file was not checked")
endif()
execute_process(COMMAND "${CLI}" check "${project}" WORKING_DIRECTORY "${WORK}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "helper.lua")
  message(FATAL_ERROR "Could not check a project directory: ${output}")
endif()
file(WRITE "${project}/scripts/helper.lua" "function broken(\n")
execute_process(COMMAND "${CLI}" check WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "Nested syntax error was not detected")
endif()
file(WRITE "${project}/scripts/helper.lua" "return {}\n")
execute_process(COMMAND "${CLI}" new "${project}" RESULT_VARIABLE result)
if(result EQUAL 0)
  message(FATAL_ERROR "Existing project was accepted")
endif()
file(READ "${project}/main.lua" after)
if(NOT starter STREQUAL after)
  message(FATAL_ERROR "Existing project was changed")
endif()
file(WRITE "${project}/main.lua" "local mv = require('malvado')\nmv.start(function() print('cli works') end)\n")
execute_process(COMMAND "${CLI}" run --headless WORKING_DIRECTORY "${project}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "cli works")
  message(FATAL_ERROR "Could not run project: ${output}")
endif()
execute_process(COMMAND "${CLI}" run --headless "${project}/main.lua"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "cli works")
  message(FATAL_ERROR "Could not run explicit file: ${output}")
endif()
file(WRITE "${project}/data.txt" "project asset")
file(WRITE "${project}/main.lua" "local f = assert(io.open('data.txt')); assert(f:read('a') == 'project asset'); f:close()\nassert(type(require('scripts.helper')) == 'table')\nlocal mv = require('malvado')\nmv.start(function() print('project works') end)\n")
execute_process(COMMAND "${CLI}" run --headless "${project}" WORKING_DIRECTORY "${WORK}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "project works")
  message(FATAL_ERROR "Could not run a project directory with modules and assets: ${output}")
endif()
file(MAKE_DIRECTORY "${WORK}/empty")
execute_process(COMMAND "${CLI}" check "${WORK}/empty" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "An empty project must fail the check")
endif()
file(WRITE "${project}/side-effect.lua" "local f = assert(io.open('executed', 'w')); f:close()\n")
execute_process(COMMAND "${CLI}" check side-effect.lua WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR EXISTS "${project}/executed")
  message(FATAL_ERROR "Check executed the script or rejected valid Lua")
endif()
file(WRITE "${project}/invalid.lua" "function broken(\n")
execute_process(COMMAND "${CLI}" check invalid.lua WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "Invalid Lua must fail the check")
endif()
execute_process(COMMAND "${CLI}" check missing.lua WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "A missing file must fail the check")
endif()
execute_process(COMMAND "${CLI}" invalid RESULT_VARIABLE result)
if(NOT result EQUAL 2)
  message(FATAL_ERROR "Invalid command must report usage")
endif()
file(REMOVE_RECURSE "${WORK}")
