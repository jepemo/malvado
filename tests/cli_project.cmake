file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${CLI}" doctor RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "Lua: Lua 5.4" OR NOT output MATCHES "Graphics:" OR NOT output MATCHES "Export:")
  message(FATAL_ERROR "Doctor did not report runtime capabilities: ${output}")
endif()
set(project "${WORK}/My game")
execute_process(COMMAND "${CLI}" new "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${project}/main.lua")
  message(FATAL_ERROR "Could not create project")
endif()
file(READ "${project}/main.lua" starter)
file(MAKE_DIRECTORY "${project}/scripts" "${project}/.hidden")
file(WRITE "${project}/scripts/helper.lua" "return {}\n")
file(WRITE "${project}/.hidden/ignored.lua" "function broken(\n")
execute_process(COMMAND "${CLI}" check WORKING_DIRECTORY "${project}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "Syntax OK")
  message(FATAL_ERROR "Could not check generated game: ${output}")
endif()
if(NOT output MATCHES "helper.lua")
  message(FATAL_ERROR "Nested Lua file was not checked")
endif()
execute_process(COMMAND "${CLI}" check "${project}" WORKING_DIRECTORY "${WORK}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "helper.lua")
  message(FATAL_ERROR "Could not check a project directory: ${output}")
endif()
file(WRITE "${project}/scripts/helper.lua" "function broken(\n")
execute_process(COMMAND "${CLI}" check WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "Nested syntax error was not detected")
endif()
file(WRITE "${project}/scripts/helper.lua" "return {}\n")
execute_process(COMMAND "${CLI}" new "${project}" RESULT_VARIABLE result)
if(result EQUAL 0)
  message(FATAL_ERROR "Existing project was accepted")
endif()
file(READ "${project}/main.lua" after)
if(NOT starter STREQUAL after)
  message(FATAL_ERROR "Existing project was changed")
endif()
file(WRITE "${project}/main.lua" "local mv = require('malvado')\nmv.start(function() print('cli works') end)\n")
execute_process(COMMAND "${CLI}" run --headless WORKING_DIRECTORY "${project}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "cli works")
  message(FATAL_ERROR "Could not run project: ${output}")
endif()
execute_process(COMMAND "${CLI}" run --headless "${project}/main.lua"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "cli works")
  message(FATAL_ERROR "Could not run explicit file: ${output}")
endif()
file(WRITE "${project}/data.txt" "project asset")
file(WRITE "${project}/main.lua" "local f = assert(io.open('data.txt')); assert(f:read('a') == 'project asset'); f:close()\nassert(type(require('scripts.helper')) == 'table')\nlocal mv = require('malvado')\nmv.start(function() print('project works') end)\n")
execute_process(COMMAND "${CLI}" run --headless "${project}" WORKING_DIRECTORY "${WORK}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "project works")
  message(FATAL_ERROR "Could not run a project directory with modules and assets: ${output}")
endif()
file(MAKE_DIRECTORY "${WORK}/empty")
execute_process(COMMAND "${CLI}" check "${WORK}/empty" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "An empty project must fail the check")
endif()
file(WRITE "${project}/side-effect.lua" "local f = assert(io.open('executed', 'w')); f:close()\n")
execute_process(COMMAND "${CLI}" check side-effect.lua WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR EXISTS "${project}/executed")
  message(FATAL_ERROR "Check executed the script or rejected valid Lua")
endif()
file(WRITE "${project}/invalid.lua" "function broken(\n")
execute_process(COMMAND "${CLI}" check invalid.lua WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "Invalid Lua must fail the check")
endif()
execute_process(COMMAND "${CLI}" check missing.lua WORKING_DIRECTORY "${project}" RESULT_VARIABLE result)
if(NOT result EQUAL 1)
  message(FATAL_ERROR "A missing file must fail the check")
endif()
execute_process(COMMAND "${CLI}" invalid RESULT_VARIABLE result)
if(NOT result EQUAL 2)
  message(FATAL_ERROR "Invalid command must report usage")
endif()
file(REMOVE_RECURSE "${WORK}")
