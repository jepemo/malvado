file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/project/assets" "${WORK}/project/scripts" "${WORK}/project/build" "${WORK}/elsewhere")
file(WRITE "${WORK}/project/assets/message.txt" "asset works")
file(WRITE "${WORK}/project/scripts/helper.lua" "return 'module works'\n")
file(WRITE "${WORK}/project/build/ignored.txt" "not part of the game")
file(WRITE "${WORK}/project/build/ignored.lua" "function broken(\n")
file(WRITE "${WORK}/project/.secret" "not part of the game")
if(VISUAL)
  set(loop "local task = mv.process(function() for _ = 1, 3 do mv.draw_text('Game', 10, 10, 20); mv.frame() end end)\nmv.start(function() task() end)\n")
  set(args "")
else()
  set(loop "mv.start(function() end)\n")
  set(args "--headless")
endif()
file(WRITE "${WORK}/project/main.lua" "local file = assert(io.open('assets/message.txt')); assert(file:read('a') == 'asset works'); file:close()\nassert(require('scripts.helper') == 'module works')\nlocal mv = require('malvado')\n${loop}print('export works')\n")
execute_process(COMMAND "${CLI}" export "${WORK}/exported game" WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Export failed")
endif()
if(EXISTS "${WORK}/exported game/.secret" OR EXISTS "${WORK}/exported game/build" OR NOT EXISTS "${WORK}/exported game/licenses/LICENSE")
  message(FATAL_ERROR "Export contents are incorrect")
endif()
execute_process(COMMAND "${WORK}/exported game/game" ${args} WORKING_DIRECTORY "${WORK}/elsewhere"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "export works")
  message(FATAL_ERROR "Exported game failed: ${output}")
endif()
execute_process(COMMAND "${CLI}" export WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT EXISTS "${WORK}/project/dist/game/game")
  message(FATAL_ERROR "Default export failed")
endif()
execute_process(COMMAND "${WORK}/project/dist/game/game" ${args} WORKING_DIRECTORY "${WORK}/elsewhere"
  RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0 OR NOT output MATCHES "export works")
  message(FATAL_ERROR "Default exported game failed: ${output}")
endif()
execute_process(COMMAND "${CLI}" export WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE result)
if(result EQUAL 0 OR NOT EXISTS "${WORK}/project/dist/game/game")
  message(FATAL_ERROR "Existing default export was not protected")
endif()
execute_process(COMMAND "${CLI}" export "${WORK}/exported game" WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE result)
if(result EQUAL 0 OR NOT EXISTS "${WORK}/exported game/game")
  message(FATAL_ERROR "Existing export was not protected")
endif()
execute_process(COMMAND "${CLI}" export "${WORK}/project/nested" WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE result)
if(result EQUAL 0 OR EXISTS "${WORK}/project/nested")
  message(FATAL_ERROR "Export inside the project must be rejected")
endif()
file(WRITE "${WORK}/project/main.lua" "function broken(\n")
execute_process(COMMAND "${CLI}" export "${WORK}/invalid" WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE result)
if(result EQUAL 0 OR EXISTS "${WORK}/invalid")
  message(FATAL_ERROR "Invalid main.lua must fail before creating an export")
endif()
file(WRITE "${WORK}/project/main.lua" "print('valid')\n")
file(WRITE "${WORK}/project/scripts/helper.lua" "function broken(\n")
execute_process(COMMAND "${CLI}" export "${WORK}/invalid-module" WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE result)
if(result EQUAL 0 OR EXISTS "${WORK}/invalid-module")
  message(FATAL_ERROR "Invalid module must fail before creating an export")
endif()
file(WRITE "${WORK}/project/scripts/helper.lua" "return 'module works'\n")
file(CREATE_LINK "${WORK}/project/assets/message.txt" "${WORK}/project/link" SYMBOLIC RESULT link_result)
if(link_result STREQUAL "0")
  execute_process(COMMAND "${CLI}" export "${WORK}/with-link" WORKING_DIRECTORY "${WORK}/project" RESULT_VARIABLE result)
  if(result EQUAL 0)
    message(FATAL_ERROR "A project with symbolic links must be rejected")
  endif()
endif()
file(MAKE_DIRECTORY "${WORK}/link-project")
file(WRITE "${WORK}/link-project/main.lua" "print('valid')\n")
file(CREATE_LINK "${WORK}/elsewhere" "${WORK}/link-project/dist" SYMBOLIC RESULT link_result)
if(link_result STREQUAL "0")
  execute_process(COMMAND "${CLI}" export WORKING_DIRECTORY "${WORK}/link-project" RESULT_VARIABLE result)
  if(result EQUAL 0 OR EXISTS "${WORK}/elsewhere/game")
    message(FATAL_ERROR "Default export must reject a linked dist directory")
  endif()
endif()
file(REMOVE_RECURSE "${WORK}")
