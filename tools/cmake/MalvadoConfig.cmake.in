@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/MalvadoTargets.cmake")
set(Malvado_core_FOUND TRUE)
if(TARGET Malvado::assets)
  set(Malvado_assets_FOUND TRUE)
endif()
if("graphics" IN_LIST Malvado_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/MalvadoGraphicsTargets.cmake")
    include(CMakeFindDependencyMacro)
    if(NOT ANDROID)
      find_dependency(OpenGL)
      find_dependency(Threads)
      if(UNIX AND NOT APPLE)
        find_dependency(X11)
      endif()
    endif()
    # An SDK prefix can change when a consumer reconfigures the same build.
    unset(_malvado_raylib CACHE)
    find_library(_malvado_raylib NAMES raylib PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    if(NOT _malvado_raylib)
      set(Malvado_NOT_FOUND_MESSAGE "The SDK raylib library is missing")
      set(Malvado_FOUND FALSE)
      return()
    endif()
    if(NOT TARGET Malvado::raylib)
      add_library(Malvado::raylib UNKNOWN IMPORTED)
      set_target_properties(Malvado::raylib PROPERTIES IMPORTED_LOCATION "${_malvado_raylib}")
      if(ANDROID)
        set(_malvado_graphics_deps m log android EGL GLESv2 OpenSLES atomic c dl)
        set_target_properties(Malvado::raylib PROPERTIES
          INTERFACE_LINK_OPTIONS "-uANativeActivity_onCreate;-Wl,--wrap=fopen")
      else()
        set(_malvado_graphics_deps OpenGL::GL Threads::Threads ${CMAKE_DL_LIBS})
      endif()
      if(APPLE)
        list(APPEND _malvado_graphics_deps "-framework Cocoa" "-framework IOKit" "-framework CoreFoundation" "-framework QuartzCore")
      elseif(WIN32)
        list(APPEND _malvado_graphics_deps winmm gdi32)
      elseif(UNIX)
        list(APPEND _malvado_graphics_deps m)
        if(NOT ANDROID)
          list(APPEND _malvado_graphics_deps X11::X11)
        endif()
      endif()
      set_target_properties(Malvado::raylib PROPERTIES INTERFACE_LINK_LIBRARIES "${_malvado_graphics_deps}")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/MalvadoGraphicsTargets.cmake")
    if(ANDROID)
      # The runner is shared with the Lua player. User sources keep ordinary
      # target include paths/definitions; only their main symbol is renamed.
      set_property(TARGET Malvado::graphics PROPERTY MALVADO_ANDROID_RUNNER
        "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/malvado/android/android_game_main.c")
      function(malvado_add_android_game target)
        if(NOT ARGN)
          message(FATAL_ERROR "malvado_add_android_game requires C source files")
        endif()
        get_target_property(_runner Malvado::graphics MALVADO_ANDROID_RUNNER)
        get_filename_component(_runner_directory "${_runner}" DIRECTORY)
        add_library(${target} SHARED ${ARGN} "${_runner}")
        target_compile_options(${target} PRIVATE "-include" "${_runner_directory}/android_game_entry.h")
        target_compile_definitions(${target} PRIVATE main=malvado_game_main MALVADO_ANDROID_NATIVE_GAME)
        target_include_directories(${target} PRIVATE "${ANDROID_NDK}/sources/android/native_app_glue")
        target_link_libraries(${target} PRIVATE Malvado::graphics)
        set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON PREFIX "lib" OUTPUT_NAME game)
      endfunction()
    endif()
    set(Malvado_graphics_FOUND TRUE)
  endif()
endif()
check_required_components(Malvado)
