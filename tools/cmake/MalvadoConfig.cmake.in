@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/MalvadoTargets.cmake")
set(Malvado_core_FOUND TRUE)
if(TARGET Malvado::assets)
  set(Malvado_assets_FOUND TRUE)
endif()
if("graphics" IN_LIST Malvado_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/MalvadoGraphicsTargets.cmake")
    include(CMakeFindDependencyMacro)
    find_dependency(OpenGL)
    find_dependency(Threads)
    # An SDK prefix can change when a consumer reconfigures the same build.
    unset(_malvado_raylib CACHE)
    find_library(_malvado_raylib NAMES raylib PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" NO_DEFAULT_PATH)
    if(NOT _malvado_raylib)
      set(Malvado_NOT_FOUND_MESSAGE "The SDK raylib library is missing")
      set(Malvado_FOUND FALSE)
      return()
    endif()
    if(NOT TARGET Malvado::raylib)
      add_library(Malvado::raylib UNKNOWN IMPORTED)
      set_target_properties(Malvado::raylib PROPERTIES IMPORTED_LOCATION "${_malvado_raylib}")
      set(_malvado_graphics_deps OpenGL::GL Threads::Threads ${CMAKE_DL_LIBS})
      if(APPLE)
        list(APPEND _malvado_graphics_deps "-framework Cocoa" "-framework IOKit" "-framework CoreFoundation")
      elseif(WIN32)
        list(APPEND _malvado_graphics_deps winmm gdi32)
      elseif(UNIX)
        list(APPEND _malvado_graphics_deps m)
      endif()
      set_target_properties(Malvado::raylib PROPERTIES INTERFACE_LINK_LIBRARIES "${_malvado_graphics_deps}")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/MalvadoGraphicsTargets.cmake")
    set(Malvado_graphics_FOUND TRUE)
  endif()
endif()
check_required_components(Malvado)
